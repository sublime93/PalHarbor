{
  "name": "@paldeck/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "predev": "pnpm --filter @paldeck/database build",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretest": "pnpm --filter @paldeck/database build",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "latest",
    "@paldeck/database": "workspace:*",
    "dotenv": "latest",
    "fastify": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "vitest": "latest"
  }
}
