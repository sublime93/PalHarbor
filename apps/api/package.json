{
  "name": "@app/api",
  "private": true,
  "author": "Jordan Vohwinkel",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "files": [
    "dist",
    "scripts",
    "package.json"
  ],
  "scripts": {
    "predev": "pnpm --filter @app/database build",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "maps:sync": "node scripts/sync-map-assets.mjs",
    "pretest": "pnpm --filter @app/database build",
    "test": "vitest run src",
    "pretest:coverage": "pnpm --filter @app/database build",
    "test:coverage": "vitest run src --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "10.1.2",
    "@app/database": "workspace:0.1.0",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "@vitest/coverage-v8": "4.1.10",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "4.1.10"
  }
}
