{
  "name": "palharbor-workspace",
  "private": true,
  "type": "module",
  "author": "Jordan Vohwinkel",
  "license": "MIT",
  "homepage": "https://github.com/sublime93/PalHarbor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sublime93/PalHarbor.git"
  },
  "bugs": {
    "url": "https://github.com/sublime93/PalHarbor/issues"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "concurrently -k -n gateway,web -c yellow,cyan \"pnpm --filter @app/api dev\" \"pnpm --filter @app/web dev\"",
    "docs:dev": "pnpm --filter @app/docs dev",
    "docs:build": "pnpm --filter @app/docs build",
    "docs:preview": "pnpm --filter @app/docs preview",
    "maps:sync": "pnpm --filter @app/api maps:sync",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage && pnpm build",
    "db:generate": "pnpm --filter @app/database generate",
    "db:push": "pnpm --filter @app/database db:push",
    "start": "pnpm --filter @app/api start"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "concurrently": "10.0.3",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0"
  }
}
