{
  "name": "@app/database",
  "version": "0.1.0",
  "private": true,
  "author": "Jordan Vohwinkel",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "files": [
    "dist",
    "generated",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "schema:render": "node scripts/render-prisma-schemas.mjs",
    "generate": "pnpm schema:render && prisma generate --schema prisma/.generated/schema.sqlite.prisma && prisma generate --schema prisma/.generated/schema.postgresql.prisma",
    "db:push": "pnpm schema:render && prisma db push",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@prisma/adapter-libsql": "7.9.0",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "17.4.2",
    "prisma": "7.9.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "4.1.10"
  }
}
