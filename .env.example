# Copy this file to .env before running Docker Compose.
# Replace every value marked "replace-me".

# Palworld REST API on the private Docker Compose network.
PALWORLD_API_URL=http://palworld:8212/v1/api
PALWORLD_USERNAME=admin
PALWORLD_PASSWORD=replace-me-with-your-palworld-admin-password
PALWORLD_SERVER_PASSWORD=

# Separate credentials used to sign in to PalHarbor.
PALHARBOR_IMAGE_TAG=latest
PALHARBOR_USERNAME=operator
PALHARBOR_PASSWORD=replace-me-with-a-long-unique-password

# Keep the dashboard on this machine unless trusted LAN or VPN access is needed.
PALHARBOR_BIND_ADDRESS=127.0.0.1
PALHARBOR_PORT=4174
PALHARBOR_ALLOWED_HOSTS=
PALHARBOR_ALLOWED_ORIGINS=
ALLOW_UNAUTHENTICATED_REMOTE=false

# Activity history uses SQLite in the persistent Docker volume by default.
DATABASE_URL=file:./data/palharbor.sqlite
ACTIVITY_ENABLED=true
ACTIVITY_POLL_SECONDS=15
ACTIVITY_RETENTION_DAYS=90
STORE_PLAYER_IPS=false
LOG_LEVEL=info

# Terrain maps download automatically. Override these HTTPS URLs to use a
# different trusted source, or disable synchronization explicitly.
PALWORLD_MAP_SYNC_ENABLED=true
PALWORLD_MAP_PALPAGOS_URL=https://raw.githubusercontent.com/deafdudecomputers/PalworldSaveTools/main/resources/assets/maps/T_WorldMap.webp
PALWORLD_MAP_WORLD_TREE_URL=https://raw.githubusercontent.com/deafdudecomputers/PalworldSaveTools/main/resources/assets/maps/T_TreeMap.webp
